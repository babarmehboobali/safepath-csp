    {
      "id": "CSP-Q-0001",
      "hashKey": "a_safety_manager_tests_combustible_gas_levels_inside_a_hydrocarbon",
      "classification": {
        "sessionId": 1,
        "sessionTitle": "Advanced Applied Mathematics & Stat",
        "domainId": 1,
        "domainTitle": "Domain 1: Advanced Sciences & Math",
        "standardOrCode": "NFPA 69 / API 2015",
        "tags": ["LFL", "Combustible Gas", "Math", "Atmospheric Testing"]
      },
      "question": "A safety manager tests combustible gas levels inside a hydrocarbon storage vessel. The lower explosive limit (LFL) of the vapor is 1.4% by volume. The portable multi-gas detector reads 25% of the LFL. What is the actual volumetric concentration of the vapor inside the tank?",
      "options": [
        "0.35% by volume",
        "0.70% by volume",
        "1.05% by volume",
        "3.50% by volume"
      ],
      "correct": 0,
      "explanation": "Step 1: Identify that 100% LFL corresponds to 1.4% actual vapor concentration by volume. Step 2: Calculate the measured percentage: 0.25 × 1.4% = 0.35% by volume.",
      "applicability": {
        "includeInQuizPortal": true,
        "includeInDomainScenarios": true,
        "includeInFullMock": true,
        "includeInSelfAssessment": true
      },
      "flashcardEquivalent": {
        "enabled": true,
        "cardCategory": "math",
        "badge": "Applied Calculations",
        "front": "Calculating Volumetric % from % LFL",
        "back": "Actual % by Vol = (% LFL Instrument Reading / 100) × Pure Chemical LFL Volumetric Threshold."
      }
    },
    {
